<Application
    x:Class="Go2HDR.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:conv="clr-namespace:Go2HDR.Converters"
    ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
            <conv:SdrToNitsConverter         x:Key="SdrToNitsConverter"/>
            <conv:HdrStatusColorConverter    x:Key="HdrStatusColorConverter"/>
            <conv:HdrStatusBackgroundConverter x:Key="HdrStatusBackgroundConverter"/>
            <BooleanToVisibilityConverter    x:Key="BoolToVis"/>

        </ResourceDictionary>
    </Application.Resources>
</Application>
