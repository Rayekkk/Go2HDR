<Page
    x:Class="Go2HDR.Views.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Settings"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ScrollViewer x:Name="RootScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,16,24,24" MaxWidth="820">

            <!-- Personalization -->
            <TextBlock Text="Personalization" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,8"/>

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="App Theme" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Choose Light or Dark, or follow the Windows system setting."
                                   FontSize="12" Opacity="0.7" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ComboBox Grid.Column="1" VerticalAlignment="Center"
                              ItemsSource="{Binding Themes}"
                              SelectedIndex="{Binding SelectedThemeIndex}"/>
                </Grid>
            </ui:Card>

            <!-- Behavior -->
            <TextBlock Text="Behavior" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,16,0,8"/>

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start with Windows" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock FontSize="12" Opacity="0.7" Margin="0,3,0,0" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Start Go2HDR automatically when you log into Windows."/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AutostartInstalled}" Value="True">
                                            <Setter Property="Text" Value="Go2HDR will start automatically at login."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding AutostartInstalled}"/>
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Minimize to Tray" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="When closing the window, minimize to the system tray instead of exiting."
                                   FontSize="12" Opacity="0.7" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding MinimizeToTray}"/>
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Start Minimized" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Launch Go2HDR directly to the system tray without showing the window."
                                   FontSize="12" Opacity="0.7" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding StartMinimized}"/>
                </Grid>
            </ui:Card>

            <!-- Updates -->
            <TextBlock Text="Updates" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,16,0,8"/>

            <ui:Card Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Check for updates on startup" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Automatically check for a new version each time Go2HDR launches."
                                   FontSize="12" Opacity="0.7" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                     IsChecked="{Binding CheckUpdatesOnStartup}"/>
                </Grid>
            </ui:Card>

            <ui:Card Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Software Updates" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding UpdateStatusText}"
                                   FontSize="12" Opacity="0.7" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:Button Content="Check for Updates"
                                   Icon="{ui:SymbolIcon ArrowSync24}"
                                   Command="{Binding CheckForUpdatesCommand}"
                                   IsEnabled="{Binding CanCheckForUpdates}"/>
                        <Border Margin="0,6,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UpdateAvailable}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <ui:Button Content="Open release page"
                                       Icon="{ui:SymbolIcon Open24}"
                                       Command="{Binding OpenReleasePageCommand}"
                                       Appearance="Primary"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- About -->
            <TextBlock Text="About" FontSize="13" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,0,0,8"/>

            <ui:Card>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Image Width="48" Height="48" Margin="0,0,16,0"
                           Source="pack://application:,,,/Assets/Go2HDR_About.png"
                           RenderOptions.BitmapScalingMode="HighQuality"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Go2HDR" FontSize="16" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding AppVersionLabel}"
                                       FontSize="11" Opacity="0.45"
                                       VerticalAlignment="Bottom" Margin="8,0,0,2"/>
                        </StackPanel>
                        <TextBlock Text="Automatic SDR brightness compensation for HDR displays"
                                   FontSize="12" Opacity="0.7" Margin="0,4,0,0"/>
                        <TextBlock Text="Optimized for Lenovo Legion Go 2"
                                   FontSize="11" Opacity="0.5" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</Page>
