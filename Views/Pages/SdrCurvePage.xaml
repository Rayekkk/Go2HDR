<Page
    x:Class="Go2HDR.Views.Pages.SdrCurvePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ctrl="clr-namespace:Go2HDR.Views.Controls"
    xmlns:models="clr-namespace:Go2HDR.Models"
    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    Title="SDR Curve"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <CollectionViewSource x:Key="PointsDesc" Source="{Binding CurvePoints}">
            <CollectionViewSource.SortDescriptions>
                <scm:SortDescription PropertyName="Brightness" Direction="Descending"/>
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Sticky header: always visible -->
        <StackPanel Grid.Row="0" Margin="24,16,24,8">

            <!-- Title -->
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="SDR Brightness Curve"
                           FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Margin="0,4,0,0" FontSize="13" Opacity="0.65" TextWrapping="Wrap"
                           Text="Map every brightness level to an SDR white level. Edit values in the table — the graph updates live."/>
            </StackPanel>

            <!-- Curve preview (read-only) -->
            <ui:CardExpander
                Header="Curve Preview"
                IsExpanded="True"
                Margin="0,0,0,12">
                <ctrl:CurveEditor
                    x:Name="CurveEditorControl"
                    Height="260"
                    IsReadOnly="True"
                    Points="{Binding CurvePoints}"
                    SelectedPoint="{Binding SelectedPoint, Mode=TwoWay}"
                    MinBrightness="{Binding MinimumBrightness}"
                    Margin="0,8,0,4"/>
            </ui:CardExpander>

            <!-- Minimum brightness + reset row -->
            <Border Margin="0,0,0,8" Padding="8,6"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Minimum brightness:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ui:NumberBox
                            Value="{Binding PendingMinBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            Minimum="1" Maximum="80"
                            SmallChange="1" LargeChange="5"
                            SpinButtonPlacementMode="Inline"
                            Width="130"/>
                        <TextBlock Text="% → SDR 0 (80 nits)"
                                   VerticalAlignment="Center" Margin="10,0,12,0" Opacity="0.65" FontSize="12"/>
                        <ui:Button
                            Content="Apply"
                            Icon="{ui:SymbolIcon Checkmark24}"
                            Command="{Binding ApplyMinBrightnessCommand}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <ui:Button
                            Content="Set All to 100"
                            Icon="{ui:SymbolIcon ArrowMaximize24}"
                            Command="{Binding SetAllTo100Command}"
                            Appearance="Secondary"
                            Margin="0,0,8,0"/>
                        <ui:Button
                            Content="Reset to Default"
                            Icon="{ui:SymbolIcon ArrowReset24}"
                            Command="{Binding ResetToDefaultCommand}"
                            Appearance="Secondary"/>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>

        <!-- Table with native DataGrid scrolling -->
        <ui:Card Grid.Row="1" Padding="0" Margin="24,0,24,24">
            <DataGrid
                ItemsSource="{Binding Source={StaticResource PointsDesc}}"
                SelectedItem="{Binding SelectedPoint, Mode=TwoWay}"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                SelectionMode="Single"
                GridLinesVisibility="Horizontal"
                HeadersVisibility="Column"
                BorderThickness="0"
                Background="Transparent"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                VirtualizingPanel.ScrollUnit="Pixel"
                CellEditEnding="OnCellEditEnding"
                PreparingCellForEdit="OnPreparingCellForEdit">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Brightness (%)"
                        Binding="{Binding Brightness, StringFormat={}{0:F0}}"
                        IsReadOnly="True"
                        Width="*"/>
                    <DataGridTemplateColumn Header="SDR Level" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:CurvePoint}">
                                <TextBlock Text="{Binding SdrValue, StringFormat={}{0:F0}}"
                                           Margin="4,0" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate DataType="{x:Type models:CurvePoint}">
                                <ui:NumberBox
                                    Value="{Binding SdrValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Minimum="0" Maximum="100"
                                    SmallChange="1" LargeChange="5"
                                    SpinButtonPlacementMode="Inline"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Luminance (nits)" Width="*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate DataType="{x:Type models:CurvePoint}">
                                <TextBlock
                                    Text="{Binding SdrValue, Converter={StaticResource SdrToNitsConverter}}"
                                    Margin="4,0" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </ui:Card>

    </Grid>
</Page>
