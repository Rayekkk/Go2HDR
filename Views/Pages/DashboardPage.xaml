<Page
    x:Class="Go2HDR.Views.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:ctrl="clr-namespace:Go2HDR.Views.Controls"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ScrollViewer x:Name="RootScroller" VerticalScrollBarVisibility="Auto" PanningMode="VerticalFirst">
        <StackPanel Margin="24,16,24,24" MaxWidth="900">

            <!-- ── Update banner (visible only when an update is available) ── -->
            <ui:InfoBar
                IsOpen="{Binding UpdateAvailable, Mode=OneWay}"
                IsClosable="False"
                Severity="Informational"
                Title="Update available"
                Message="{Binding UpdateVersion, StringFormat='Go2HDR {0} is ready to download.'}"
                Margin="0,0,0,16">
                <ui:Button Content="Open release page"
                           Command="{Binding OpenReleasePageCommand}"
                           Appearance="Primary"
                           HorizontalAlignment="Left"
                           Margin="0,4,0,0"/>
            </ui:InfoBar>

            <!-- ── Main switch ── -->
            <Border CornerRadius="8" Margin="0,0,0,16" Padding="16,14"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Go2HDR" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Automatic SDR white level adjustment"
                                   FontSize="12" Opacity="0.65" Margin="0,2,0,0"/>
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1"
                                     IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                     VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── Status card ── -->
            <Border CornerRadius="8" Margin="0,0,0,16"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,14,0"
                             VerticalAlignment="Center"
                             Fill="{Binding IsHdrActive, Converter={StaticResource HdrStatusColorConverter}}"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold"
                                   Text="{Binding HdrStatusLabel}"/>
                        <TextBlock FontSize="12" Margin="0,3,0,0" Opacity="0.65" TextWrapping="Wrap"
                                   Text="{Binding StatusDescription}"/>
                    </StackPanel>

                    <Border Grid.Column="2" CornerRadius="4" Padding="10,3" VerticalAlignment="Center"
                            Background="{Binding IsHdrActive, Converter={StaticResource HdrStatusBackgroundConverter}}">
                        <TextBlock FontSize="11" FontWeight="SemiBold"
                                   Text="{Binding HdrStatusLabel}"
                                   Foreground="{Binding IsHdrActive, Converter={StaticResource HdrStatusColorConverter}}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Live stats (3 cards) ── -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="8" Padding="16,14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Screen Brightness" FontSize="11" Opacity="0.6"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding BrightnessText}" FontSize="36" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,6,0,8"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                        <ProgressBar Value="{Binding CurrentBrightness, Mode=OneWay}"
                                     Minimum="0" Maximum="100" Height="4"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" CornerRadius="8" Padding="16,14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="SDR White Level" FontSize="11" Opacity="0.6"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding SdrText}" FontSize="36" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,6,0,8"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                        <ProgressBar Value="{Binding CurrentSdrValue, Mode=OneWay}"
                                     Minimum="0" Maximum="100" Height="4"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" CornerRadius="8" Padding="16,14"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Luminance" FontSize="11" Opacity="0.6"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding NitsText}" FontSize="30" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,6,0,8"
                                   Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
                        <ProgressBar Value="{Binding CurrentNits, Mode=OneWay}"
                                     Minimum="80" Maximum="480" Height="4"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── SDR Curve preview ── -->
            <Border CornerRadius="8" Margin="0,0,0,16" Padding="16,12"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Active SDR Curve"
                                   FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" FontSize="11" Opacity="0.55" VerticalAlignment="Center"
                                   FontFamily="Consolas" Text="nits = 80 + level × 4"/>
                    </Grid>
                    <ctrl:CurveEditor
                        Height="220"
                        IsReadOnly="True"
                        ShowPoints="False"
                        Points="{Binding CurvePoints}"
                        SelectedPoint="{Binding ActivePoint, Mode=OneWay}"
                        MinBrightness="{Binding MinBrightness}"
                        Margin="0,4,0,8"/>
                    <TextBlock FontSize="12" Opacity="0.65">
                        <Run Text="Luminance range: "/>
                        <Run Text="{Binding SdrRangeText, Mode=OneWay}" FontWeight="SemiBold"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ── Info bar ── -->
            <ui:InfoBar
                IsOpen="True" IsClosable="False" Severity="Informational"
                Title="Lenovo Legion Go 2"
                Message="HDR state is detected instantly via Windows display events. When HDR is active, screen brightness is read via WMI and mapped to the SDR white level using your custom curve."/>

        </StackPanel>
    </ScrollViewer>
</Page>
